import { Button, ScrollView, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct Alarm {
    id: string,
    name: string,
    note: string,
    interval_minutes: int,
    start_hour: int,
    end_hour: int,
    is_active: bool,
}

export component App inherits Window {
    preferred-width: 400px;
    preferred-height: 750px;
    title: "Repeat Alarm";
    default-font-family: "Segoe UI";
    
    background: #3E2723;

    property <int> screen-state: 0;
    in-out property <[Alarm]> alarms: [];

    property <string> editing-id: "";
    property <string> editing-name: "";
    property <string> editing-note: "";
    property <int> editing-interval: 60;
    property <int> editing-start: 8;
    property <int> editing-end: 22;

    callback save-alarm(string, string, string, int, int, int);
    callback toggle-alarm(string, bool);
    callback delete-alarm(string);

    // --- SCREEN 0: ALARM LIST ---
    if screen-state == 0 : VerticalBox {
        padding: 25px;
        spacing: 20px;

        Text {
            text: "My Alarms";
            font-size: 32px;
            font-weight: 900;
            color: #FFF8F0;
        }

        ScrollView {
            VerticalBox {
                alignment: start;
                spacing: 15px;
                for alarm in alarms : Rectangle {
                    height: 110px;
                    background: #FFFFFF;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: alarm.is_active ? #D35400 : #A1887F;

                    HorizontalBox {
                        padding: 15px;
                        VerticalBox {
                            alignment: center;
                            Text { 
                                text: alarm.name; 
                                font-size: 20px; 
                                font-weight: 800; 
                                color: #212121;
                            }
                            Text { 
                                text: "Every " + alarm.interval_minutes + "m (" + alarm.start_hour + ":00 - " + alarm.end_hour + ":00)";
                                font-size: 14px; 
                                color: #5D4037; 
                            }
                        }
                        
                        VerticalBox {
                            alignment: center;
                            spacing: 8px;
                            Button {
                                text: alarm.is_active ? "ON" : "OFF";
                                width: 70px;
                                clicked => { toggle-alarm(alarm.id, !alarm.is_active); }
                            }
                            Button {
                                text: "Edit";
                                width: 70px;
                                clicked => {
                                    editing-id = alarm.id;
                                    editing-name = alarm.name;
                                    editing-note = alarm.note;
                                    editing-interval = alarm.interval_minutes;
                                    editing-start = alarm.start_hour;
                                    editing-end = alarm.end_hour;
                                    screen-state = 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        Button {
            text: "+ Add New Alarm";
            height: 55px;
            clicked => {
                editing-id = ""; editing-name = ""; editing-note = "";
                editing-interval = 60; editing-start = 8; editing-end = 22;
                screen-state = 1;
            }
        }
    }

    // --- SCREEN 1: ADD/EDIT ---
    if screen-state == 1 : VerticalBox {
        padding: 30px;
        spacing: 15px;
        alignment: start;

        Text {
            text: editing-id == "" ? "Create Alarm" : "Update Alarm";
            font-size: 28px; 
            font-weight: 900; 
            color: #f2b476; 
            padding-bottom: 10px;
        }

        // Row 1: Alarm Name
        VerticalBox {
            padding: 0;
            spacing: 5px;
            Text { text: "Alarm Name"; color: #FFF8F0; font-weight: 700; font-size: 15px; }
            LineEdit { 
                text: editing-name; 
                height: 40px;
                edited(t) => { editing-name = t; } 
            }
        }
        
        // Row 2: Message Note
        VerticalBox {
            padding: 0;
            spacing: 5px;
            Text { text: "Message Note"; color: #FFF8F0; font-weight: 700; font-size: 15px; }
            LineEdit { 
                text: editing-note; 
                height: 40px;
                edited(t) => { editing-note = t; } 
            }
        }

        // Row 3: Interval (Full width or aligned)
        VerticalBox {
            padding: 0;
            spacing: 5px;
            Text { text: "Interval (mins)"; color: #FFF8F0; font-weight: 700; font-size: 15px; }
            LineEdit { 
                height: 40px;
                text: editing-interval; 
                input-type: number; 
                edited(t) => { editing-interval = t.to-float(); } 
            }
        }

        // Row 4: Start and End Hour (Symmetric)
        HorizontalBox {
            padding: 0;
            spacing: 20px;
            VerticalBox {
                padding: 0;
                spacing: 5px;
                horizontal-stretch: 1;
                Text { text: "Start Hour"; color: #FFF8F0; font-weight: 700; font-size: 15px; }
                LineEdit { 
                    height: 40px;
                    text: editing-start; 
                    input-type: number; 
                    edited(t) => { editing-start = t.to-float(); } 
                }
            }
            VerticalBox {
                padding: 0;
                spacing: 5px;
                horizontal-stretch: 1;
                Text { text: "End Hour"; color: #FFF8F0; font-weight: 700; font-size: 15px; }
                LineEdit { 
                    height: 40px;
                    text: editing-end; 
                    input-type: number; 
                    edited(t) => { editing-end = t.to-float(); } 
                }
            }
        }

        Rectangle { height: 15px; }

        // Row 5: Actions
        HorizontalBox {
            padding: 0;
            spacing: 20px;
            Button { 
                text: "Cancel"; 
                height: 50px; 
                horizontal-stretch: 1; 
                clicked => { screen-state = 0; } 
            }
            Button {
                text: "Save Alarm";
                height: 50px;
                horizontal-stretch: 1;
                primary: true;
                clicked => {
                    save-alarm(editing-id, editing-name, editing-note,
                        editing-interval, editing-start, editing-end);
                    screen-state = 0;
                }
            }
        }
        
        if editing-id != "" : Button {
            text: "Delete Alarm";
            height: 45px;
            clicked => { delete-alarm(editing-id); screen-state = 0; }
        }
    }
}
