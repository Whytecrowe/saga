// ============================================================
// Theme — the single source of design tokens (the "theme.slint"
// idea from the mockups). Every component reads Theme.<token>.
// Swapping themes later = making `active` drive these values.
// This is the locked "Warm & Cozy" palette.
// ============================================================

export global Theme {
    // ---- palette (Warm & Cozy) ----
    out property <color> bg: #fffaf0;
    out property <color> bg-2: #fff3e0;
    out property <color> surface: #fffdf8;
    out property <color> surface-2: #fbf2e2;

    out property <color> ink: #3e2723;
    out property <color> ink-soft: #7a6a5f;
    out property <color> ink-faint: #a99c91;

    out property <color> accent: #d98e04;
    out property <color> accent-2: #f3c969;
    out property <color> clay: #b5651d;
    out property <color> line: #efe2cf;
    out property <color> on-accent: #ffffff;

    // ---- shape ----
    out property <length> radius: 16px;
    out property <length> radius-sm: 10px;

    // ---- motion ----
    // Durations are tokens so the whole app feels consistent.
    out property <duration> quick: 200ms;
    out property <duration> base: 320ms;

    // springs slightly past
    // the target and settles back. Shared across the whole app.
    // can be changed later or modified with themes
    out property <easing> doey: cubic-bezier(0.34, 1.56, 0.64, 1);
    out property <easing> smooth: cubic-bezier(0.16, 1, 0.3, 1);
}
