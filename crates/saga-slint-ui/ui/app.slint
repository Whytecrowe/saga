import { Theme } from "theme.slint";
import { Card, PrimaryButton, GhostButton, Chip, CheckBox, TextField, TextArea, SegTab } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// One Echo, flattened for display.
export struct EchoItem {
    id: string,
    kind: string,
    title: string,
    body: string,
    time: string,
    completed: bool,
    priority: string,
    checklist-done: int,
    checklist-total: int,
    mood: int,
    energy: int,
    has-mood: bool,
    has-energy: bool,
    pinned: bool,
    tags: [string],
}

// A single day on the timeline, holding that day's Echoes.
export struct DaySignpost {
    iso: string,
    label: string,
    rel: string,
    is-today: bool,
    echoes: [EchoItem],
}

// One editable checklist row in the composer.
export struct ChecklistDraft {
    text: string,
    done: bool,
}

export component App inherits Window {
    title: "Saga";
    preferred-width: 560px;
    preferred-height: 820px;
    default-font-size: 15px;
    default-font-family: "Segoe UI";
    background: Theme.bg;

    // Data supplied by Rust.
    in property <[DaySignpost]> days;
    in property <string> today-iso;

    // Which screen is showing: "today" or "path".
    property <string> current-view: "path";

    // Composer state. draft-id == "" means "creating a new Echo".
    property <bool> composer-open: false;
    property <string> draft-id: "";
    property <string> draft-kind: "plain";
    property <string> draft-day: "";
    property <string> draft-title: "";
    property <string> draft-body: "";
    property <string> draft-priority: "medium";
    property <bool> draft-completed: false;

    in property <[ChecklistDraft]> draft-checklist;
    property <string> draft-new-item: "";

    // Type-picker + delete-menu state.
    property <bool> picker-open: false;
    property <bool> confirm-open: false;
    property <string> confirm-id: "";

    // Long-press bookkeeping for the shared root Timer below.
    property <string> hold-id: "";
    property <bool> hold-fired: false;

    callback create-plain(string, string);                  // (day, body)
    callback update-plain(string, string);                  // (id, body)
    callback create-task(string, string, string, string, bool);  // (day, title, desc, priority, completed)
    callback update-task(string, string, string, string, bool);  // (id, title, desc, priority, completed)
    callback toggle-complete(string);                       // (id)
    callback delete-echo(string);                           // (id)

    callback checklist-add(string);                         // (text)
    callback checklist-remove(int);                         // (index)
    callback checklist-toggle(int);                         // (index)
    callback begin-task-edit(string);                       // "" = new task; id loads its items

    function open-new-plain() {
        root.draft-id = "";
        root.draft-kind = "plain";
        root.draft-day = root.today-iso;
        root.draft-body = "";
        root.composer-open = true;
    }
    function open-new-task() {
        root.draft-id = "";
        root.draft-kind = "task";
        root.draft-day = root.today-iso;
        root.draft-title = "";
        root.draft-body = "";
        root.draft-priority = "medium";
        root.draft-completed = false;
        root.draft-new-item = "";
        root.begin-task-edit("");
        root.composer-open = true;
    }
    function open-editor(item: EchoItem) {
        root.draft-id = item.id;
        root.draft-kind = item.kind;
        root.draft-title = item.title;
        root.draft-body = item.body;
        root.draft-priority = item.priority == "" ? "medium" : item.priority;
        root.draft-completed = item.completed;
        root.draft-new-item = "";
        root.begin-task-edit(item.kind == "task" ? item.id : "");
        root.composer-open = true;
    }
    function ask-delete(id: string) {
        root.confirm-id = id;
        root.confirm-open = true;
    }

    // Fires ~0.5s after a card press begins, unless the finger lifts
    // first (which clears hold-id and stops the timer).
    Timer {
        interval: 500ms;
        running: root.hold-id != "";
        triggered => {
            root.hold-fired = true;
            root.ask-delete(root.hold-id);
            root.hold-id = "";
        }
    }

    // ---- header + scrolling timeline ----
    VerticalLayout {
        Rectangle {
            height: 84px;
            VerticalLayout {
                padding: 22px;
                padding-bottom: 8px;
                alignment: end;
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    Text {
                        text: "Saga";
                        color: Theme.clay;
                        font-size: 26px;
                        font-weight: 800;
                    }
                    Text {
                        text: "echoes of your path";
                        color: Theme.ink-faint;
                        font-size: 13px;
                        vertical-alignment: bottom;
                    }
                }
            }
        }

        // view switch: Today vs Path
        HorizontalLayout {
            alignment: start;
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 10px;
            Rectangle {
                height: 38px;
                border-radius: 12px;
                background: Theme.surface-2;
                border-width: 1px;
                border-color: Theme.line;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    SegTab {
                        label: "Today";
                        active: root.current-view == "today";
                        clicked => { root.current-view = "today"; }
                    }
                    SegTab {
                        label: "Path";
                        active: root.current-view == "path";
                        clicked => { root.current-view = "path"; }
                    }
                }
            }
        }

        // Today screen
        if root.current-view == "today" : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text {
                text: "Today";
                color: Theme.ink;
                font-size: 22px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: "Your seed and today's tasks will live here.";
                color: Theme.ink-faint;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if root.current-view == "path" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding: 22px;
                padding-top: 4px;
                spacing: 4px;

                for day in root.days : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    padding-top: 14px;

                    // day signpost
                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        Text {
                            text: day.label;
                            color: Theme.ink;
                            font-size: 16px;
                            font-weight: 800;
                        }
                        Text {
                            text: day.rel;
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // cards for this day
                    for echo in day.echoes : Card {
                        clicked => {
                            if (!root.hold-fired) {
                                root.open-editor(echo);
                            }
                        }
                        delete-requested => { root.ask-delete(echo.id); }
                        hold-started => {
                            root.hold-fired = false;
                            root.hold-id = echo.id;
                        }
                        hold-ended => { root.hold-id = ""; }

                        VerticalLayout {
                            padding: 16px;
                            spacing: 9px;

                            // task header: completion box + title
                            if echo.kind == "task" : HorizontalLayout {
                                alignment: start;
                                spacing: 10px;
                                CheckBox {
                                    checked: echo.completed;
                                    toggled => { root.toggle-complete(echo.id); }
                                }
                                Text {
                                    text: echo.title;
                                    color: echo.completed ? Theme.ink-faint : Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // body: plain markdown, or task description
                            if echo.body != "" : Text {
                                text: echo.body;
                                color: echo.kind == "task" ? Theme.ink-soft : Theme.ink;
                                font-size: echo.kind == "task" ? 14px : 15px;
                                wrap: word-wrap;
                            }

                            // timestamp + metadata pills
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                Text {
                                    text: echo.time;
                                    color: Theme.ink-faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                if echo.kind == "task" && echo.priority != "" : Rectangle {
                                    height: 22px;
                                    border-radius: 6px;
                                    background: echo.priority == "critical" ? #f7d6d2
                                        : echo.priority == "high" ? #fbe3cf
                                        : echo.priority == "medium" ? #fdf2d6
                                        : #eef3ec;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: echo.priority;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            color: echo.priority == "critical" ? #c0392b
                                                : echo.priority == "high" ? #c2671d
                                                : echo.priority == "medium" ? #b58a18
                                                : #6f8a5f;
                                        }
                                    }
                                }
                                if echo.checklist-total > 0 : Chip {
                                    text: "\{echo.checklist-done}/\{echo.checklist-total}";
                                }
                                if echo.has-mood : Chip { text: "mood \{echo.mood}"; }
                                if echo.has-energy : Chip { text: "energy \{echo.energy}"; }
                                if echo.pinned : Chip { text: "pinned"; }
                                for t in echo.tags : Chip { text: "#\{t}"; }
                            }
                        }
                    }
                }

                // clearance so the FAB never covers the last card
                Rectangle { height: 96px; }
            }
        }
    }

    // ---- floating "+" button ----
    Rectangle {
        property <length> size: 58px;
        width: self.size;
        height: self.size;
        x: root.width - self.width - 22px;
        y: root.height - self.height - 22px;
        background: fab.pressed ? Theme.clay : Theme.accent;
        border-radius: 19px;
        drop-shadow-color: #b5651d80;
        drop-shadow-blur: fab.has-hover ? 34px : 20px;
        drop-shadow-offset-y: 9px;
        animate background, drop-shadow-blur {
            duration: Theme.quick;
            easing: Theme.doey;
        }

        // "+" icon: two centered bars
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.on-accent;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 22px;
            border-radius: 1.5px;
            background: Theme.on-accent;
        }

        fab := TouchArea {
            clicked => { root.picker-open = true; }
        }
    }

    // ---- type picker (choose Echo vs Task Echo) ----
    Rectangle {
        width: 100%;
        height: 100%;
        visible: picker-open;

        Rectangle {
            background: #3e2723;
            opacity: picker-open ? 0.34 : 0.0;
            animate opacity { duration: Theme.base; }
            TouchArea {
                clicked => { root.picker-open = false; }
            }
        }

        Rectangle {
            width: Math.min(420px, parent.width - 40px);
            height: 130px;
            x: (parent.width - self.width) / 2;
            y: picker-open ? (parent.height - self.height) / 2 : parent.height;
            opacity: picker-open ? 1.0 : 0.0;
            background: Theme.surface;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: #3e272366;
            drop-shadow-blur: 50px;
            drop-shadow-offset-y: 18px;
            animate y, opacity {
                duration: Theme.base;
                easing: Theme.doey;
            }

            HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                pick-plain := Rectangle {
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: pp.has-hover ? Theme.accent : Theme.line;
                    background: pp.has-hover ? Theme.surface-2 : Theme.bg;
                    animate border-color, background { duration: Theme.quick; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "Echo";
                            font-size: 16px;
                            font-weight: 800;
                            color: Theme.ink;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "a freeform note";
                            font-size: 12px;
                            color: Theme.ink-faint;
                            horizontal-alignment: center;
                        }
                    }
                    pp := TouchArea {
                        clicked => {
                            root.picker-open = false;
                            root.open-new-plain();
                        }
                    }
                }

                pick-task := Rectangle {
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: pt.has-hover ? Theme.accent : Theme.line;
                    background: pt.has-hover ? Theme.surface-2 : Theme.bg;
                    animate border-color, background { duration: Theme.quick; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "Task Echo";
                            font-size: 16px;
                            font-weight: 800;
                            color: Theme.ink;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "something to do";
                            font-size: 12px;
                            color: Theme.ink-faint;
                            horizontal-alignment: center;
                        }
                    }
                    pt := TouchArea {
                        clicked => {
                            root.picker-open = false;
                            root.open-new-task();
                        }
                    }
                }
            }
        }
    }

    // ---- composer overlay (create / edit) ----
    // Kept in the tree and gated by `visible` so the text inputs
    // compile cleanly (see the Slint 1.9.1 note in components).
    Rectangle {
        width: 100%;
        height: 100%;
        visible: composer-open;

        Rectangle {
            background: #3e2723;
            opacity: composer-open ? 0.34 : 0.0;
            animate opacity { duration: Theme.base; }
            TouchArea {
                clicked => { root.composer-open = false; }
            }
        }

        // panel slides up from the bottom and fades in
        Rectangle {
            width: Math.min(520px, parent.width - 32px);
            height: Math.min(580px, parent.height - 80px);
            x: (parent.width - self.width) / 2;
            y: composer-open ? (parent.height - self.height) / 2 : parent.height;
            opacity: composer-open ? 1.0 : 0.0;
            background: Theme.surface;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: #3e272366;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 22px;
            animate y, opacity {
                duration: Theme.base;
                easing: Theme.doey;
            }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                // header (pinned)
                HorizontalLayout {
                    Text {
                        text: (root.draft-id == "" ? "New " : "Edit ") + (root.draft-kind == "task" ? "Task Echo" : "Echo");
                        color: Theme.ink;
                        font-size: 18px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        text: "✕";
                        width: 42px;
                        clicked => { root.composer-open = false; }
                    }
                }

                // scrolling form (header + buttons stay pinned)
                form := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: form.visible-width;
                        spacing: 12px;

                        // title (tasks only)
                        if root.draft-kind == "task" : TextField {
                            text <=> root.draft-title;
                            placeholder: "What needs doing?";
                        }

                        // body: plain markdown, or task description
                        TextArea {
                            text <=> root.draft-body;
                            placeholder: root.draft-kind == "task" ? "Add a description…" : "Write your echo…";
                            height: root.draft-kind == "task" ? 100px : 240px;
                        }

                        // checklist (tasks only)
                        if root.draft-kind == "task" : VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Checklist";
                                color: Theme.ink-soft;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            for item[idx] in root.draft-checklist : HorizontalLayout {
                                spacing: 10px;
                                CheckBox {
                                    checked: item.done;
                                    toggled => { root.checklist-toggle(idx); }
                                }
                                Text {
                                    text: item.text;
                                    color: item.done ? Theme.ink-faint : Theme.ink;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                // remove item
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 8px;
                                    background: rm.has-hover ? #c0392b14 : transparent;
                                    animate background { duration: Theme.quick; }
                                    Text {
                                        text: "✕";
                                        color: Theme.ink-faint;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    rm := TouchArea {
                                        clicked => { root.checklist-remove(idx); }
                                    }
                                }
                            }

                            // add-item row (Enter to add)
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 7px;
                                    border-width: 2px;
                                    border-color: Theme.ink-faint;
                                }
                                TextField {
                                    flat: true;
                                    text <=> root.draft-new-item;
                                    placeholder: "add item…";
                                    horizontal-stretch: 1;
                                    accepted => {
                                        if (root.draft-new-item != "") {
                                            root.checklist-add(root.draft-new-item);
                                            root.draft-new-item = "";
                                        }
                                    }
                                }
                            }
                        }

                        // priority (tasks only)
                        if root.draft-kind == "task" : VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Priority";
                                color: Theme.ink-soft;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                for p in ["low", "medium", "high", "critical"] : Rectangle {
                                    height: 34px;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: root.draft-priority == p ? Theme.accent : Theme.line;
                                    background: root.draft-priority == p ? Theme.accent : Theme.bg;
                                    animate background, border-color { duration: Theme.quick; }
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: p;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        color: root.draft-priority == p ? Theme.on-accent : Theme.ink-soft;
                                    }
                                    TouchArea {
                                        clicked => { root.draft-priority = p; }
                                    }
                                }
                            }
                        }

                        // completion (tasks only) — manual, independent of the checklist
                        if root.draft-kind == "task" : HorizontalLayout {
                            spacing: 10px;
                            CheckBox {
                                checked: root.draft-completed;
                                toggled => { root.draft-completed = !root.draft-completed; }
                            }
                            Text {
                                text: "Completed";
                                color: Theme.ink-soft;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // actions (pinned)
                HorizontalLayout {
                    spacing: 10px;
                    if root.draft-id != "" : GhostButton {
                        text: "Delete";
                        width: 110px;
                        clicked => {
                            root.delete-echo(root.draft-id);
                            root.composer-open = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PrimaryButton {
                        text: "Save Echo";
                        width: 150px;
                        clicked => {
                            if (root.draft-id == "") {
                                if (root.draft-kind == "task") {
                                    root.create-task(root.draft-day, root.draft-title, root.draft-body, root.draft-priority, root.draft-completed);
                                } else {
                                    root.create-plain(root.draft-day, root.draft-body);
                                }
                            } else {
                                if (root.draft-kind == "task") {
                                    root.update-task(root.draft-id, root.draft-title, root.draft-body, root.draft-priority, root.draft-completed);
                                } else {
                                    root.update-plain(root.draft-id, root.draft-body);
                                }
                            }
                            root.composer-open = false;
                        }
                    }
                }
            }
        }
    }

    // ---- delete menu (long-press / right-click) ----
    Rectangle {
        width: 100%;
        height: 100%;
        visible: confirm-open;

        Rectangle {
            background: #3e2723;
            opacity: confirm-open ? 0.34 : 0.0;
            animate opacity { duration: Theme.base; }
            TouchArea {
                clicked => { root.confirm-open = false; }
            }
        }

        Rectangle {
            width: 170px;
            height: 50px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: #3e272366;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            opacity: confirm-open ? 1.0 : 0.0;
            animate opacity { duration: Theme.quick; }

            Rectangle {
                background: del-area.has-hover ? #c0392b14 : transparent;
                border-radius: 14px;
                animate background { duration: Theme.quick; }
            }
            Text {
                text: "Delete";
                color: #c0392b;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            del-area := TouchArea {
                clicked => {
                    root.delete-echo(root.confirm-id);
                    root.confirm-open = false;
                }
            }
        }
    }
}
