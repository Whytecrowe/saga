import { Theme } from "theme.slint";
import { Card, PrimaryButton, GhostButton, Chip } from "components.slint";
import { TextEdit, ScrollView } from "std-widgets.slint";

// One Echo, flattened for display on the timeline.
export struct EchoItem {
    id: string,
    body: string,
    time: string,
    mood: int,
    energy: int,
    has-mood: bool,
    has-energy: bool,
    pinned: bool,
    tags: [string],
}

// A single day on the timeline, holding that day's Echoes.
export struct DaySignpost {
    iso: string,
    label: string,
    rel: string,
    is-today: bool,
    echoes: [EchoItem],
}

export component App inherits Window {
    title: "Saga";
    preferred-width: 560px;
    preferred-height: 820px;
    default-font-size: 15px;
    background: Theme.bg;

    // Data supplied by Rust.
    in property <[DaySignpost]> days;
    in property <string> today-iso;

    // Composer state. draft-id == "" means "creating a new Echo".
    property <bool> composer-open: false;
    property <string> draft-id: "";
    property <string> draft-day: "";
    property <string> draft-body: "";

    // Delete-menu state.
    property <bool> confirm-open: false;
    property <string> confirm-id: "";

    // Long-press bookkeeping for the shared root Timer below.
    property <string> hold-id: "";
    property <bool> hold-fired: false;

    callback create-echo(string, string);   // (day-iso, body)
    callback update-echo(string, string);    // (id, body)
    callback delete-echo(string);            // (id)

    function open-new() {
        root.draft-id = "";
        root.draft-day = root.today-iso;
        root.draft-body = "";
        root.composer-open = true;
    }
    function open-editor(id: string, body: string) {
        root.draft-id = id;
        root.draft-body = body;
        root.composer-open = true;
    }
    function ask-delete(id: string) {
        root.confirm-id = id;
        root.confirm-open = true;
    }

    // Fires ~0.5s after a card press begins, unless the finger lifts
    // first (which clears hold-id and stops the timer).
    Timer {
        interval: 500ms;
        running: root.hold-id != "";
        triggered => {
            root.hold-fired = true;
            root.ask-delete(root.hold-id);
            root.hold-id = "";
        }
    }

    // ---- header + scrolling timeline ----
    VerticalLayout {
        Rectangle {
            height: 88px;
            VerticalLayout {
                padding: 22px;
                padding-bottom: 8px;
                alignment: end;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Saga";
                        color: Theme.clay;
                        font-size: 26px;
                        font-weight: 800;
                    }
                    Text {
                        text: "echoes of your path";
                        color: Theme.ink-faint;
                        font-size: 13px;
                        vertical-alignment: bottom;
                    }
                }
            }
        }

        ScrollView {
            VerticalLayout {
                padding: 22px;
                padding-top: 4px;
                spacing: 4px;

                for day in root.days : VerticalLayout {
                    spacing: 10px;
                    padding-top: 14px;

                    // day signpost
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: day.label;
                            color: Theme.ink;
                            font-size: 16px;
                            font-weight: 800;
                        }
                        Text {
                            text: day.rel;
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // cards for this day
                    for echo in day.echoes : Card {
                        clicked => {
                            if (!root.hold-fired) {
                                root.open-editor(echo.id, echo.body);
                            }
                        }
                        delete-requested => { root.ask-delete(echo.id); }
                        hold-started => {
                            root.hold-fired = false;
                            root.hold-id = echo.id;
                        }
                        hold-ended => { root.hold-id = ""; }

                        VerticalLayout {
                            padding: 16px;
                            spacing: 9px;

                            Text {
                                text: echo.body;
                                color: Theme.ink;
                                font-size: 15px;
                                wrap: word-wrap;
                            }

                            // timestamp + metadata pills
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                Text {
                                    text: echo.time;
                                    color: Theme.ink-faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                if echo.has-mood : Chip { text: "mood \{echo.mood}"; }
                                if echo.has-energy : Chip { text: "energy \{echo.energy}"; }
                                if echo.pinned : Chip { text: "pinned"; }
                                for t in echo.tags : Chip { text: "#\{t}"; }
                            }
                        }
                    }
                }

                // clearance so the FAB never covers the last card
                Rectangle { height: 96px; }
            }
        }
    }

    // ---- floating "+" button ----
    Rectangle {
        width: 62px;
        height: 62px;
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 24px;
        background: fab.pressed ? Theme.clay : Theme.accent;
        border-radius: 20px;
        drop-shadow-color: #b5651d80;
        drop-shadow-blur: fab.has-hover ? 36px : 22px;
        drop-shadow-offset-y: 10px;
        animate background, drop-shadow-blur {
            duration: Theme.quick;
            easing: Theme.doey;
        }

        Text {
            width: 100%;
            height: 100%;
            text: "+";
            color: Theme.on-accent;
            font-size: 32px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        fab := TouchArea {
            clicked => { root.open-new(); }
        }
    }

    // ---- composer overlay (create / edit) ----
    // Kept in the tree and gated by `visible` rather than `if`, so the
    // TextEdit compiles cleanly (see the Slint 1.9.1 note in components).
    Rectangle {
        width: 100%;
        height: 100%;
        visible: composer-open;

        Rectangle {
            background: #3e2723;
            opacity: composer-open ? 0.34 : 0.0;
            animate opacity { duration: Theme.base; }
            TouchArea {
                clicked => { root.composer-open = false; }
            }
        }

        // panel slides up from the bottom and fades in
        Rectangle {
            width: Math.min(520px, parent.width - 32px);
            height: Math.min(560px, parent.height - 80px);
            x: (parent.width - self.width) / 2;
            y: composer-open ? (parent.height - self.height) / 2 : parent.height;
            opacity: composer-open ? 1.0 : 0.0;
            background: Theme.surface;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: #3e272366;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 22px;
            animate y, opacity {
                duration: Theme.base;
                easing: Theme.doey;
            }

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: root.draft-id == "" ? "New Echo" : "Edit Echo";
                        color: Theme.ink;
                        font-size: 18px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        text: "✕";
                        width: 42px;
                        clicked => { root.composer-open = false; }
                    }
                }

                body-edit := TextEdit {
                    text: root.draft-body;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 10px;
                    if root.draft-id != "" : GhostButton {
                        text: "Delete";
                        width: 110px;
                        clicked => {
                            root.delete-echo(root.draft-id);
                            root.composer-open = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PrimaryButton {
                        text: "Save Echo";
                        width: 150px;
                        clicked => {
                            if (root.draft-id == "") {
                                root.create-echo(root.draft-day, body-edit.text);
                            } else {
                                root.update-echo(root.draft-id, body-edit.text);
                            }
                            root.composer-open = false;
                        }
                    }
                }
            }
        }
    }

    // ---- delete menu (long-press / right-click) ----
    Rectangle {
        width: 100%;
        height: 100%;
        visible: confirm-open;

        Rectangle {
            background: #3e2723;
            opacity: confirm-open ? 0.34 : 0.0;
            animate opacity { duration: Theme.base; }
            TouchArea {
                clicked => { root.confirm-open = false; }
            }
        }

        Rectangle {
            width: 170px;
            height: 50px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: #3e272366;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            opacity: confirm-open ? 1.0 : 0.0;
            animate opacity { duration: Theme.quick; }

            Rectangle {
                background: del-area.has-hover ? #c0392b14 : transparent;
                border-radius: 14px;
                animate background { duration: Theme.quick; }
            }
            Text {
                text: "Delete";
                color: #c0392b;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            del-area := TouchArea {
                clicked => {
                    root.delete-echo(root.confirm-id);
                    root.confirm-open = false;
                }
            }
        }
    }
}
