import { Button, ScrollView, ListView, TextEdit, ComboBox, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";

export struct EchoItem {
    id: string,
    title: string,
    markdown: string,
    preview: string,
    section-name: string,
    day: string,
    created-at: string,
}

export component App inherits Window {
    title: "Saga Journal";
    preferred-width: 400px;
    preferred-height: 700px;

    // Data from Rust
    in property <[EchoItem]> echoes: [
            // MOCK DATA FOR PREVIEW TODO: delete when releasing
            {
            id: "1",
            title: "Echo 1",
            markdown: "This is a sample echo for preview. It shows how the text wraps and displays in the list.",
            section-name: "Meditation",
            day: "2026-02-10",
            created-at: "2:30 PM"
        },
        {
            id: "2",
            title: "Echo 2",
            markdown: "Another echo with different text to see spacing and colors.",
            section-name: "Work",
            day: "2026-02-10",
            created-at: "3:45 PM"
        },
        {
            id: "3",
            title: "Echo 3",
            markdown: "A third one for good measure!",
            section-name: "Fitness",
            day: "2026-02-10",
            created-at: "5:00 PM"
        }
    ];
    in property <[string]> filtered-sections: [];

    // Callbacks to Rust
    callback load-echoes();
    callback create-echo(string /* section_name */, string /* title */, string /* markdown */);
    callback echo-tapped(string);
    callback filter-sections(string);

    // UI state
    property <string> current-screen: "list";
    property <string> selected-echo-id: "1";
    property <string> new-echo-title: "";
    property <string> new-echo-text: "";
    property <string> section-input: "";

    VerticalBox {
        // SCREEN 1: Echo List
        if current-screen == "list": VerticalBox {
            padding: 16px;
            spacing: 12px;

            Text {
                text: "Today's Echoes";
                font-size: 24px;
                font-weight: 700;
            }

            Button {
                text: "Create New Echo";
                clicked => {
                    new-echo-text = "";
                    section-input = "";
                    current-screen = "create";
                }
            }

            if echoes.length == 0: Text {
                text: "No echoes yet. Create your first one!";
                color: #888;
                horizontal-alignment: center;
            }

            if echoes.length > 0: ScrollView {
                ListView {
                    for echo in echoes: Rectangle {
                        height: 100px;
                        background: #b2b0b1;
                        border-radius: 15px;
                        border-width: 2px;
                        border-color: #ddd;

                        TouchArea {
                            clicked => {
                                selected-echo-id = echo.id;
                                current-screen = "view";
                            }
                        }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;

                            Text {
                                text: echo.section-name;
                                font-size: 12px;
                                color: #933030;
                                font-weight: 600;
                            }

                            Text {
                                text: echo.title;
                                font-size: 14px;
                                font-weight: 800;
                                color: #c43838;
                            }

                            Text {
                                text: echo.preview;
                                font-size: 14px;
                                color: #222;
                                overflow: elide;
                            }

                            Text {
                                text: echo.created-at;
                                font-size: 11px;
                                color: #888;
                            }
                        }
                    }
                }
            }
        }

        // SCREEN 2: Create Echo
        if current-screen == "create": VerticalBox {
            padding: 16px;
            spacing: 12px;

            HorizontalBox {
                Button {
                    text: "← Back";
                    clicked => {
                        current-screen = "list";
                    }
                }

                Text {
                    text: "New Echo";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: "Section:";
                font-size: 14px;
            }

            LineEdit {
                text <=> section-input;
                placeholder-text: "Type section name...";

                edited => {
                    filter-sections(self.text);
                }
            }

            if section-input != "" && filtered-sections.length > 0: Rectangle {
                max-height: 150px;
                border-radius: 4px;
                background: #f5f5f5;
                border-width: 1px;
                border-color: #ccc;

                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;

                        for section in filtered-sections: Rectangle {
                            height: 32px;
                            background: touch.has-hover ? #e0e0e0 : transparent;
                            border-radius: 4px;

                            touch := TouchArea {
                                clicked => {
                                    section-input = section;
                                    filter-sections("");
                                }
                            }

                            Text {
                                text: section;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                padding-left: 8px;
                                color: #280b0b;
                            }
                        }
                    }
                }
            }

            Text {
                text: "Title:";
                font-size: 14px;
            }

            LineEdit {
                text <=> new-echo-title;
                placeholder-text: "Echo Title...";
            }

            Text {
                text: "Content:";
                font-size: 14px;
            }

            TextEdit {
                text <=> new-echo-text;
                preferred-height: 300px;
            }

            Button {
                text: "Save Echo";
                enabled: new-echo-text != "" && section-input != "" && new-echo-title != "";
                clicked => {
                    create-echo(section-input, new-echo-title, new-echo-text);
                    section-input = "";
                    new-echo-text = "";
                    new-echo-title = "";
                    current-screen = "list";
                    load-echoes();
                }
            }
        }

        // SCREEN 3: View Echo
        if current-screen == "view": VerticalBox {
            padding: 16px;
            spacing: 12px;
            vertical-stretch: 1;

            Button {
                text: "← Back to List";
                clicked => {
                    current-screen = "list";
                }
            }

            Rectangle {
                vertical-stretch: 1;
                clip: true;
                background: #1a1a1a;
                border-radius: 8px;

                ScrollView {
                    viewport-height: view-content.preferred-height;

                    view-content := VerticalLayout {
                        padding: 12px;
                        spacing: 0px;

                        for echo in echoes: VerticalLayout {
                            // only render the element if this is the one we want
                            if echo.id == selected-echo-id: VerticalLayout {
                                spacing: 12px;

                                Text {
                                    text: echo.section-name;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: #e8a96a;
                                }

                                Text {
                                    text: "Date: " + echo.day + " | " + echo.created-at;
                                    font-size: 12px;
                                    color: #888;
                                }

                                Text {
                                    text: echo.title;
                                    font-size: 22px;
                                    font-weight: 800;
                                    color: #e86a6a;
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #333;
                                }

                                Text {
                                    text: echo.markdown;
                                    font-size: 16px;
                                    color: #eee;
                                    wrap: word-wrap;
                                    horizontal-alignment: left;
                                }

                                Rectangle {
                                    height: 20px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
